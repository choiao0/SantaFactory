# T3 AMR — 무시 규칙
#
# 이 폴더만 덮는다. 저장소 루트 `.gitignore` 는 다른 파트와 공유하므로
# 여기 규칙을 거기 넣으면 `out/` · `logs/` 같은 흔한 이름이 전 파트에 걸린다.
#
# 경위: 2026-09-11 이관 때 파일은 옮겼는데 `kimHySoo/Santa` 의 무시 규칙을
# 안 옮겼다. 그래서 `git add .` 한 번에 로봇 에셋(수백 MB)과 실행 산출물이
# 통째로 스테이징됐다. 규칙을 파일과 같이 옮긴다.

# --- 대용량 원본 에셋 ---
#   iw.hub USD. 커밋하지 않고 `tools/fetch_iwhub.py` 로 받는다
#   ($ROBOT = $W/robots/iwhub/iw_hub.usd — paths.sh 와 같은 자리).
robots/

# --- 파생물: 빌드로 다시 만들어진다 ---
stage/
stage_old/
*.usd
*.usda
*.usdc
#   ★ 창고 씬만 예외. 이건 **커밋된 소스**다 (격자에서 다시 지으려면
#     warehouse/scene/build_scene.py + rack_units.npy · columns.npy 가 필요).
!warehouse/scene/warehouse_scene.usd

# --- 실행 결과 ---
out/
logs/
#   컨테이너 bind mount(/data): out · stage · logs · state — deploy/compose.yml. (gitignore 는 줄 안 주석을 못 쓴다 — 패턴 뒤에 # 를 붙이면 패턴의 일부가 된다)
deploy/data/
#   MinIO sim-runner 자격 — compose env_file (-233)
deploy/.env
*.mp4
*.npz
*.etli

# --- 원도면·중간 산출물 ---
*.dxf
*.pgm

# --- 파이썬 ---
__pycache__/
*.pyc
venv/
.venv/
.env

# --- Jupyter (서버가 jupyter04 라 자주 생긴다) ---
.ipynb_checkpoints/

# --- 패치 스크립트 백업 ---
#   patch_*.py 가 원본을 `<파일>.bak.<타임스탬프>` 로 남긴다.
*.bak
*.bak.*

# --- 압축 업로드 ---
*.tar.gz

# ※ 맵(`warehouse/map/*.npy` · `*.json`)은 **커밋된 소스**다. 무시하지 않는다.
#    기준 해시는 warehouse/map/NOTE.md 참조.
# ※ 계획 산출물(`plan/` · `v2/traj_*`)도 추적한다 — run_record.sh 가 디렉터리
#    존재로 0초 검사를 하므로 새 체크아웃에서 바로 돌아야 한다.

# --- 문서 (2026-09-15) ---
#   t3_amr 의 .md 는 저장소에 올리지 않는다. 이 한 줄이 하위 폴더까지 전부
#   덮는다 — docs/ 도 warehouse/ 안의 NOTE·README 도 포함이다.
#   추적 중이던 7개는 `git rm --cached` 로 함께 뺐다. **로컬 파일은 그대로다.**
#
#   ★ .gitignore 는 **추적 중이 아닌** 파일에만 걸린다. `git add -f` 는 못
#     막으므로 `.githooks/pre-commit` 이 한 겹 더 막는다 (이 저장소는
#     core.hooksPath=.githooks 라 `.git/hooks/` 는 안 돈다).

*.md

# --- FMS 주문 재료 (2026-09-16, -224) ---
#   FMS 가 재현 절차 §1-1 로 보내 준 주문 파일·배정표·생성기다. 5 MB 대이고
#   **통합 때 백엔드 생성분으로 교체 예정**이라고 명시돼 있어 저장소에 넣지
#   않는다. 대신 sha256 앞 16자를 `tools/fms_orders_check.py` 가 들고 있어,
#   어느 사본이든 같은 것인지 0초에 확인된다.
#
#       orders6000_s101_cap10.json   121c2c13aeb89bca
#       orders6000_s103_cap10.json   08d844b745b8a8cf
#       orders6000_s104_cap10.json   60e59afda40b4c22
#
#   FMS 에서 다시 받거나 `generate_orders.py` 로 만든다.
tools/_orders/
.cache/

# --- 문서 보관소 (2026-09-21) ---
#   `docs/archive/` 는 **로컬 보관**이다. 지운 브랜치에서 꺼낸 것, 갈아엎기 전의
#   옛 판 같은 것을 둔다. 저장소에 올리지 않는다 — t3_amr 의 .md 는 어차피
#   `.githooks/pre-commit` 이 막고, CSV·스크립트까지 같이 올리면 히스토리만 불어난다.
#
#   ☹ 그래서 **이 PC 에만 있다.** 지우면 끝이다.
#      `docs/archive/240-squash-전/` 은 그 브랜치가 유일한 사본이던 87개다.

# --- docs/ 통째로 (2026-09-22) ---
#   위의 `*.md` 가 문서 대부분을 이미 덮고 있었지만, `.html` 같은 다른 확장자가
#   들어오면서 구멍이 났다. **폴더째** 막는다 — 이 폴더는 t3_amr 안에서만
#   보는 것이고, 저장소에 올리면 히스토리만 불어난다.
#
#   ★ 이 한 줄이 `docs/archive/` 도 포함한다. 위 두 규칙(`*.md` · archive)은
#     이제 중복이지만, **왜 막는지**가 각각 다르므로 설명으로 남겨 둔다.
#
#   ☹ 그래서 docs/ 는 **이 PC 에만 있다.** 지우면 끝이다.
docs/
