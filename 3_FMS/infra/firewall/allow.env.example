# 3_FMS/infra/firewall/allow.env 로 복사해 채운다 (gitignore — 환경값이지 비밀은 아니다).
# 값은 공백 구분 IP 또는 CIDR. 비우면 그 포트는 공인 NIC 에서 전부 차단된다.
IFACE=ens5                          # EC2 공인 NIC (ip route get 8.8.8.8 로 확인)
ALLOW_1883="203.0.113.10"           # EMQX MQTT  — 클라우드 GPU 노드 등. 지금 정당한 클라이언트는 전부 tailnet 이라 비워도 된다
# GCP DES 워커(NAT 34.47.111.62)는 1883·9002 를 안 쓴다 — 5671 은 호스트 ufw 규칙(infra/nginx/README.md)
ALLOW_9002="203.0.113.10"           # MinIO S3   — 같은 목록. 브라우저 재생은 443 → nginx /media → 127.0.0.1:9002 라 무관
