# 3_FMS/infra/emqx 환경변수 견본. 이 파일을 .env 로 복사해 값을 채운다 — .env 와 users.csv 는 커밋되지 않는다.
# 비밀번호에 쉼표(,) 는 쓰지 않는다 (users.csv 가 CSV).

# EMQX 노드 쿠키 · 대시보드 admin 초기 비밀번호 (compose 가 환경변수로 주입)
EMQX_NODE_COOKIE=
EMQX_DASHBOARD_PASSWORD=

# MQTT 계정 (사용자명 = 계약 §3). amr01..amrNN 은 같은 비밀번호를 쓴다 — sim-runner 가 N 대를 한 계정군으로 띄운다
AMR_POOL_SIZE=6
MQTT_PW_AMR=
MQTT_PW_FMS_CORE=
MQTT_PW_SIM_RUNNER=
MQTT_PW_HOST_ORCH=
MQTT_PW_SIM_WMS=

# 테스트(contracts/tests/test_acl_matrix.py) 가 붙을 브로커
MQTT_HOST=localhost
MQTT_PORT=1883
