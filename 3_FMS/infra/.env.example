# θ 탐색 스택 환경변수 견본 (S15P21A106-127)
#
# 이 파일을 .env 로 복사하고 비밀번호를 채운다. .env 는 커밋되지 않는다.
#
#   cd 3_FMS/infra
#   cp .env.example .env
#   # POSTGRES_PASSWORD 를 아무 값으로 바꾼 뒤
#   docker compose up -d postgres
#
# POSTGRES_PASSWORD 를 비워두면 compose 가 명시적 오류로 멈춘다 — 기본값을
# 두면 그게 그대로 쓰이면서 저장소에 자격증명이 남는 것과 같아진다.
POSTGRES_USER=optuna
POSTGRES_DB=optuna
POSTGRES_PASSWORD=
