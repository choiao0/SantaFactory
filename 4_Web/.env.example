DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# RabbitMQ (백엔드·시뮬 엔진 워커 공용)
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# MinIO (검증 영상 저장소)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Redis (refresh 토큰 저장소)
# 값에 $ # 따옴표 공백을 쓰지 말 것 — compose 보간·redis-server 명령줄·healthcheck 를 거친다.
#   openssl rand -hex 24
REDIS_PASSWORD=

# JWT 서명 키. HS256 이라 최소 32바이트(256비트) 필요.
#   openssl rand -base64 48
JWT_SECRET=

# 관리자 계정. 가입 API 로는 만들 수 없어(가입은 항상 USER) 기동 시 주입한다.
# 비밀번호를 비우면 계정을 만들지 않는다 — 운영 전환 시 값만 빼면 된다.
# ⚠ 계정이 이미 있으면 건너뛰므로, 값을 바꿔도 기존 비밀번호는 변하지 않는다.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 데모 USER 계정. 시드 창고(주인 없는 창고)를 이 계정에 귀속시킨다.
# 창고 등록 화면이 생기면 이 값을 비워 끈다.
DEMO_PASSWORD=
